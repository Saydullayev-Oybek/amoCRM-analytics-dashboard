# Namuna. Nusxa oling -> profiles.yml va to'ldiring (profiles.yml git'ga tushmaydi).
# Host'dan: host=localhost, port=5433. Docker ichidan: host=analytics-db, port=5432.
amocrm:
  target: dev
  outputs:
    dev:
      type: postgres
      host: localhost
      port: 5433
      user: postgres
      password: your-postgres-password
      dbname: amocrm
      schema: analytics
      threads: 4
