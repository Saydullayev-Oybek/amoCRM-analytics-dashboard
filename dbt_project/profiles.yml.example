# Namuna. Nusxa oling -> profiles.yml va to'ldiring (profiles.yml git'ga tushmaydi).
# Ikkala target ham kerak:
#   dev    — HOST kompyuterdan qo'lda "dbt build" uchun    (localhost:5433)
#   docker — Airflow DAG konteyner ichidan ishlatadi        (analytics-db:5432)
# Parol ikkalasida bir xil — bu bitta bazaning ikki xil manzili.
amocrm:
  target: dev
  outputs:
    dev:
      type: postgres
      host: localhost
      port: 5433
      user: postgres
      password: your-postgres-password
      dbname: amocrm
      schema: analytics
      threads: 4

    docker:
      type: postgres
      host: analytics-db
      port: 5432
      user: postgres
      password: your-postgres-password
      dbname: amocrm
      schema: analytics
      threads: 4
